# Neon PostgreSQL (use pooler host + sslmode=require)
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Local Docker Postgres:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/deep_trace_security
# Local fallback without Docker:
# DATABASE_URL=sqlite:///./deep_trace.db
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
SEED_DATABASE=true
